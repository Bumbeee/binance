{
	"uid": "market-overview",
	"title": "Market / Load Overview",
	"tags": ["market"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 2,
	"refresh": "5s",
	"time": { "from": "now-15m", "to": "now" },
	"templating": {
		"list": [
			{
				"name": "job",
				"label": "Service",
				"type": "query",
				"datasource": { "type": "prometheus", "uid": "prometheus" },
				"query": {
					"query": "label_values(rpc_server_call_duration_seconds_count, job)",
					"refId": "job"
				},
				"refresh": 2,
				"includeAll": true,
				"multi": true,
				"allValue": ".*",
				"current": { "selected": true, "text": "All", "value": "$__all" }
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Total RPS",
			"gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum(rate(rpc_server_call_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))"
				}
			],
			"fieldConfig": {
				"defaults": { "unit": "reqps", "decimals": 1 },
				"overrides": []
			},
			"options": { "graphMode": "area", "colorMode": "value" }
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Server errors, %",
			"description": "Internal, Unknown, Unavailable, DeadlineExceeded, DataLoss, ResourceExhausted. Client errors (InvalidArgument, NotFound, FailedPrecondition...) are not counted.",
			"gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "(sum(rate(rpc_server_call_duration_seconds_count{job=~\"$job\",rpc_response_status_code=~\"Internal|Unknown|Unavailable|DeadlineExceeded|DataLoss|ResourceExhausted\"}[$__rate_interval])) or vector(0)) / sum(rate(rpc_server_call_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 0.01 },
							{ "color": "red", "value": 0.05 }
						]
					}
				},
				"overrides": []
			},
			"options": { "graphMode": "area", "colorMode": "background" }
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Latency p95",
			"gridPos": { "x": 10, "y": 0, "w": 5, "h": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 3,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 0.1 },
							{ "color": "red", "value": 0.5 }
						]
					}
				},
				"overrides": []
			},
			"options": { "graphMode": "area", "colorMode": "background" }
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Latency p99",
			"gridPos": { "x": 15, "y": 0, "w": 5, "h": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 3,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 0.25 },
							{ "color": "red", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"options": { "graphMode": "area", "colorMode": "background" }
		},
		{
			"id": 5,
			"type": "stat",
			"title": "Targets up",
			"gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [{ "refId": "A", "expr": "sum(up{job=~\"$job\"})" }],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null },
							{ "color": "green", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"options": { "colorMode": "background" }
		},

		{
			"id": 6,
			"type": "timeseries",
			"title": "RPS by method",
			"gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (rpc_method) (rate(rpc_server_call_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
					"legendFormat": "{{rpc_method}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"custom": { "fillOpacity": 10, "lineWidth": 1 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["mean", "max"]
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Latency percentiles (all methods)",
			"gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.50, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
					"legendFormat": "p50"
				},
				{
					"refId": "B",
					"expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
					"legendFormat": "p95"
				},
				{
					"refId": "C",
					"expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
					"legendFormat": "p99"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"custom": { "fillOpacity": 5, "lineWidth": 2 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "displayMode": "list", "placement": "bottom" },
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},

		{
			"id": 8,
			"type": "timeseries",
			"title": "Responses by status code",
			"description": "Stacked: shows the share of OK vs rejected requests.",
			"gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (rpc_response_status_code) (rate(rpc_server_call_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
					"legendFormat": "{{rpc_response_status_code}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps",
					"custom": {
						"fillOpacity": 40,
						"lineWidth": 1,
						"stacking": { "mode": "normal", "group": "A" }
					}
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["mean"]
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "Latency p95 by method",
			"gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
					"legendFormat": "{{rpc_method}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"custom": { "fillOpacity": 0, "lineWidth": 1 }
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "bottom",
					"calcs": ["mean", "max"]
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			}
		},

		{
			"id": 10,
			"type": "heatmap",
			"title": "Latency distribution (heatmap)",
			"description": "Where requests fall by duration. A band moving up means the system is slowing under load.",
			"gridPos": { "x": 0, "y": 20, "w": 12, "h": 9 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (le) (increase(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))",
					"format": "heatmap",
					"legendFormat": "{{le}}"
				}
			],
			"options": {
				"calculate": false,
				"cellGap": 1,
				"color": {
					"mode": "scheme",
					"scheme": "Spectral",
					"fill": "dark-orange",
					"scale": "exponential",
					"exponent": 0.5,
					"steps": 64
				},
				"yAxis": { "unit": "s", "axisPlacement": "left" },
				"legend": { "show": true },
				"tooltip": { "show": true, "yHistogram": false }
			},
			"fieldConfig": { "defaults": {}, "overrides": [] }
		},
		{
			"id": 11,
			"type": "bargauge",
			"title": "Slowest methods (p95, current)",
			"gridPos": { "x": 12, "y": 20, "w": 12, "h": 9 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"instant": true,
					"expr": "topk(10, histogram_quantile(0.95, sum by (le, rpc_method) (rate(rpc_server_call_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))))",
					"legendFormat": "{{rpc_method}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"min": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 0.1 },
							{ "color": "red", "value": 0.5 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"orientation": "horizontal",
				"displayMode": "gradient",
				"showUnfilled": true
			}
		},

		{
			"id": 12,
			"type": "timeseries",
			"title": "Postgres pool: total connections",
			"gridPos": { "x": 0, "y": 29, "w": 8, "h": 7 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "pgxpool_total_connections{job=~\"$job\"}",
					"legendFormat": "{{job}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"decimals": 0,
					"custom": { "fillOpacity": 10, "lineWidth": 1 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "displayMode": "list", "placement": "bottom" },
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 13,
			"type": "timeseries",
			"title": "Memory (RSS)",
			"gridPos": { "x": 8, "y": 29, "w": 8, "h": 7 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "process_resident_memory_bytes{job=~\"$job\"}",
					"legendFormat": "{{job}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bytes",
					"custom": { "fillOpacity": 10, "lineWidth": 1 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "displayMode": "list", "placement": "bottom" },
				"tooltip": { "mode": "multi" }
			}
		},
		{
			"id": 14,
			"type": "timeseries",
			"title": "CPU (cores)",
			"gridPos": { "x": 16, "y": 29, "w": 8, "h": 7 },
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"targets": [
				{
					"refId": "A",
					"expr": "rate(process_cpu_seconds_total{job=~\"$job\"}[$__rate_interval])",
					"legendFormat": "{{job}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "none",
					"custom": { "fillOpacity": 10, "lineWidth": 1 }
				},
				"overrides": []
			},
			"options": {
				"legend": { "displayMode": "list", "placement": "bottom" },
				"tooltip": { "mode": "multi" }
			}
		}
	]
}
